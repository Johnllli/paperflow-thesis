<Window x:Class="PaperFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PaperFlow"
        mc:Ignorable="d"
        Title="PaperFlow" Height="650" Width="1000"
        Background="{DynamicResource BgColor}"
        Foreground="{DynamicResource InkColor}">

    <Window.Resources>
        <Style x:Key="ThemeSegmentStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MuteColor}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment"
                            CornerRadius="13"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment"
                                    Property="BorderBrush"
                                    Value="{DynamicResource InkColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource SideColor}" BorderBrush="{DynamicResource LineColor}" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <!--bottom part-->
                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--setting button-->
                    <Button Grid.Column="0"
                        x:Name="SettingsButton" Click="SettingsButton_Click" Content="⚙"
                        FontSize="16" Background="Transparent" Foreground="{DynamicResource MuteColor}"
                        BorderThickness="0" HorizontalAlignment="Left" ToolTip="Settings" />        
                    
                    <!--day night theme-->
                    <Border Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BgColor}"
                            CornerRadius="99"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Day"
                                 GroupName="PaperFlowTheme"
                                 IsChecked="True"
                                 Style="{StaticResource ThemeSegmentStyle}"/>

                            <RadioButton Content="Night"
                                 GroupName="PaperFlowTheme"
                                 Checked="NightThemeButton_Checked"
                                 Unchecked="NightThemeButton_Unchecked"
                                 Style="{StaticResource ThemeSegmentStyle}"/>       
                        </StackPanel>
                    </Border>

                </Grid>
                
                <!--top part-->
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="+ New Chat" Height="36" Margin="0,0,0,8" 
                            Background="{DynamicResource PanelColor}" BorderBrush="{DynamicResource LineColor}" Foreground="{DynamicResource InkColor}"
                            HorizontalContentAlignment="Left" Padding="10,0"/>
                    
                    <Button Content="Document inventory" Height="36" 
                            Background="Transparent" Foreground="{DynamicResource InkColor}"
                            BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,0"/>

                    <TextBlock Text="Chat history" Foreground="{DynamicResource MuteColor}" FontSize="12" Margin="8,16,0,8"/>
                    <TextBlock Text="No chats yet" Foreground="{DynamicResource MuteColor}" FontSize="12" Margin="8,0,0,0"/>
                </StackPanel>

                
            </DockPanel>
            

        </Border>   

        <!--Main Conte-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--Header-->
            <Border Grid.Row="0" BorderBrush="{DynamicResource LineColor}" BorderThickness="0,0,0,1" Padding="16,0">
                <TextBlock Text="Paper Desk" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
            </Border>
            
            <!--Text Area-->
            <Grid Grid.Row="1" Margin="24">
                <TextBlock x:Name="ResultTextBox" Text="Ask your papers anything..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#66727E" FontSize="16"/>
            </Grid>

            <!--Input Area-->
            <Border Grid.Row="2" Padding="24.12">
                <Grid Background="{DynamicResource PanelColor}" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputTextBox" Grid.Column="0" Text="Ask about your documents…" BorderThickness="0" 
                             VerticalContentAlignment="Center" Padding="10,0" 
                             Background="Transparent" Foreground="{DynamicResource InkColor}" CaretBrush="{DynamicResource InkColor}"/>
                    <Button x:Name="SendButton" Click="SendButton_click" Grid.Column="1" Content="Send" Width="70" Margin="4" 
                            Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentTextColor}" BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
