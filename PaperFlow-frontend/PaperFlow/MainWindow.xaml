<Window x:Class="PaperFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PaperFlow"
        mc:Ignorable="d"
        Title="PaperFlow" Height="650" Width="1000"
        Background="#F3F5F7">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <!--side bar-->
        <Border Grid.Column="0" Background="#E8ECF0" Padding="12">
            <StackPanel>
                <Button Content="+ New Chat" Height="36" Margin="0,0,0,8" Background="White" BorderBrush="#D8DEE4"/>

                <Button Content="Document Inventory" HorizontalAlignment="Left" Height="36" Background="Transparent" BorderThickness="0"/>
                <TextBlock Text="Chat History" Foreground="#66727E" FontSize="12" Margin="0,16,0,8"/>
                <TextBlock Text="No History yet" Foreground="#8B97A3" FontSize="12" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!--Main Conte-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--Header-->
            <Border Grid.Row="0" BorderBrush="#D8DEE4" BorderThickness="0,0,0,1" Padding="16,0">
                <TextBlock Text="Paper Desk" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
            </Border>
            
            <!--Text Area-->
            <Grid Grid.Row="1" Margin="24">
                <TextBlock x:Name="ResultTextBox" Text="Ask your papers anything..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#66727E" FontSize="16"/>
            </Grid>

            <!--Input Area-->
            <Border Grid.Row="2" Padding="24.12">
                <Grid Background="White" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputTextBox" Grid.Column="0" Text="Ask about your documents…" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" Background="Transparent"/>
                    <Button x:Name="SendButton" Click="SendButton_click" Grid.Column="1" Content="Send" Width="70" Margin="4" Background="#0F766E" Foreground="White" BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
